      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
      <collision name="w_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 6.1 1.0</size></box></geometry></collision>
      <visual name="w_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 6.1 1.0</size></box></geometry><material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material></visual>
