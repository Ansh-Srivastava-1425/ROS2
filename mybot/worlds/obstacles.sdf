<?xml version="1.0"?>
<sdf version="1.9">
  <world name="obstacle_world">

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= LIGHTING ================= -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light type="point" name="lamp_left_room">
      <pose>-2 0 2.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1.0 0.9 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light type="point" name="lamp_right_room">
      <pose>2 0 2.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.7 0.85 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light type="spot" name="spot_over_table">
      <pose>-2.8 1.8 2.2 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1.0 1.0 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <direction>0 0 -1</direction>
      <spot><inner_angle>0.4</inner_angle><outer_angle>0.8</outer_angle><falloff>1.0</falloff></spot>
    </light>

    <!-- ================= GROUND ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- floor finishes (visual only, 4 mm thick) -->
    <model name="floor_wood_left">
      <static>true</static>
      <pose>-2 0 0 0 0 0</pose>
      <link name="link">
      <visual name="f_vis"><pose>0 0 0.002 0 0 0</pose><geometry><box><size>3.9 5.9 0.004</size></box></geometry><material><ambient>0.76 0.6 0.4 1</ambient><diffuse>0.76 0.6 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="floor_tile_right">
      <static>true</static>
      <pose>2 0 0 0 0 0</pose>
      <link name="link">
      <visual name="f_vis"><pose>0 0 0.002 0 0 0</pose><geometry><box><size>3.9 5.9 0.004</size></box></geometry><material><ambient>0.65 0.72 0.78 1</ambient><diffuse>0.65 0.72 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="rug">
      <static>true</static>
      <pose>-2 0.3 0 0 0 0</pose>
      <link name="link">
      <visual name="r_vis"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>2.4 1.6 0.004</size></box></geometry><material><ambient>0.6 0.12 0.12 1</ambient><diffuse>0.6 0.12 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <model name="spawn_zone_marker">
      <static>true</static>
      <pose>-3 -2 0 0 0 0</pose>
      <link name="link">
      <visual name="m_vis"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.8 0.8 0.004</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= WALLS & BOUNDARY (original 4 walls, enlarged to 8 x 6 m) ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
      <collision name="w_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>8.1 0.1 1.0</size></box></geometry></collision>
      <visual name="w_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>8.1 0.1 1.0</size></box></geometry><material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material></visual>
