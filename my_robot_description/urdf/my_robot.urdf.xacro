<?xml version="1.0"?>

<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.6"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="base_mass" value="5.0"/>

    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_length" value="0.05"/>
    <xacro:property name="wheel_mass" value="1.0"/>

    <xacro:property name="caster_radius" value="0.05"/>
    <xacro:property name="caster_mass" value="0.5"/>

    <xacro:include filename="common_property.xacro"/>


    <!-- Inertia macros -->
    <xacro:macro name="box_inertia" params="m l w h xyz">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <inertia ixx="${m/12.0 * (w*w + h*h)}" ixy="0" ixz="0"
                     iyy="${m/12.0 * (l*l + h*h)}" iyz="0"
                     izz="${m/12.0 * (l*l + w*w)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r length">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="${m/12.0 * (3*r*r + length*length)}" ixy="0" ixz="0"
                     iyy="${0.5 * m * r*r}" iyz="0"
                     izz="${m/12.0 * (3*r*r + length*length)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="${0.4 * m * r*r}" ixy="0" ixz="0"
                     iyy="${0.4 * m * r*r}" iyz="0"
                     izz="${0.4 * m * r*r}"/>
        </inertial>
    </xacro:macro>


    <!-- Links -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            <material name="green"/>
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
        </collision>

        <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}" xyz="0 0 ${base_height/2.0}"/>
    </link>


    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        </collision>

        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" length="${wheel_length}"/>
    </link>


    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        </collision>

        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" length="${wheel_length}"/>
    </link>


    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>

        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>

        <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>


    <!-- Joints -->
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${-base_length / 4.0} ${-(base_width/2.0 + wheel_length/2.0)} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${-base_length / 4.0} ${base_width/2.0 + wheel_length/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${base_length / 3.0} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
    </joint>

</robot>