<?xml version = "1.0"?>

<robot name="roboAI" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <link name="base_link"></link>

    <link name="wheel_right"></link>

    <link name="wheel_left"></link>

    <link name="lidar"></link>

    <link name="camera_link"></link>

    <link name="caster"></link>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0.0325 -0.07073 0.03245" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="wheel_right"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="0.0325 0.07073 0.03245" rpy="0 0 0"/>  
        <parent link="base_link"/>
        <child link="wheel_left"/>
        <axis xyz="0 1 0"/>
    </joint>
 
    <joint name="lidar_joint" type="fixed">
        <origin xyz="0 0 0.17" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar"/>
    </joint>

    <joint name="camera_joint" type="fixed">
        <origin xyz="0.1 0 0.1" rpy="0 0.1 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <joint name="caster_joint" type="fixed">
        <origin xyz="-0.05 0 0.02" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="caster"/>
    </joint>

</robot>