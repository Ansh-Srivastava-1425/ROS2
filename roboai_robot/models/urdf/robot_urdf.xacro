<?xml version = "1.0"?>

<robot name="roboAI" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <link name="base_link"></link>

    <link name="wheel_right"></link>

    <link name="wheel_left"></link>

    <link name="lidar"></link>

    <link name="camera"></link>

    <link name="caster"></link>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0.0 -1.0 0.0"/>
        <parent link="base_link"/>
        <child link="wheel_right"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="left_whee" type="">
        <parent link=""/>
        <child link=""/>
        
    </joint>

</robot>